    <!-- 订货习惯候选：时间窗口内某部门商品订货次数 >= minTimes -->
    <select id="countDepGoodsReorderCandidates" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM (
            SELECT dor.gb_DO_dep_dis_goods_id
            FROM gb_department_orders AS dor
            <where>
                dor.gb_DO_department_id = #{depId}
                AND dor.gb_DO_dep_dis_goods_id IS NOT NULL
                <if test="equalStatus != null">
                    AND dor.gb_DO_status = #{equalStatus}
                </if>
                <if test="startDate != null">
                    AND dor.gb_DO_arrive_date &gt;= #{startDate}
                </if>
                <if test="stopDate != null">
                    AND dor.gb_DO_arrive_date &lt;= #{stopDate}
                </if>
            </where>
            GROUP BY dor.gb_DO_dep_dis_goods_id
            HAVING COUNT(*) &gt;= #{minTimes}
        ) t
    </select>

    <select id="selectDepGoodsReorderCandidatesPage" resultType="java.lang.Integer">

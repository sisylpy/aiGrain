    <!-- 获取部门父级AI申请订单 -->
    <select id="queryApplyAiFatherOrders" resultMap="gbDepartmentOrdersMap">
        SELECT
            gb_department_orders_id,
            gb_DO_department_id,
            gb_DO_department_father_id,
            gb_DO_distributer_id,
            gb_DO_order_user_id,
            gb_DO_purchase_user_id,
            gb_DO_nx_distributer_id,
            gb_DO_status,
            gb_DO_order_type,
            gb_DO_buy_status,
            gb_DO_apply_date,
            gb_DO_arrive_date
        FROM gb_department_orders
        WHERE gb_DO_department_father_id = #{depId}
          AND gb_DO_order_type = 1
          AND gb_DO_status &gt;= 0
        ORDER BY gb_DO_apply_date DESC
    </select>


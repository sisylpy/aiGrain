<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nongxinle.mapper.GbDepFoodSalesMapper">

    <select id="countSalesByDistributerFoodId" resultType="long">
        SELECT COUNT(*)
        FROM gb_dep_food_sales s
        WHERE gb_dfs_food_id = #{distributerFoodId}
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nongxinle.mapper.GbDistributerFoodMapper">

    <!-- 菜品关联商品的结果映射（使用 JOIN） -->
    <resultMap id="foodWithGoods" type="com.nongxinle.entity.GbDistributerFoodEntity">
        <id property="gbDistributerFoodId" column="gb_distributer_food_id"/>
        <result property="gbDfDistributerId" column="gb_df_distributer_id"/>
        <result property="gbDfNxFoodId" column="gb_df_nx_food_id"/>
        <result property="gbDfFoodName" column="gb_df_food_name"/>
        <result property="gbDfFoodPrice" column="gb_df_food_price"/>
        <result property="gbDfStatus" column="gb_df_status"/>
        <result property="gbDfFoodPinyin" column="gb_df_food_pinyin"/>
        <result property="gbDfFoodPy" column="gb_df_food_py"/>
        <result property="gbDfFoodFatherId" column="gb_df_food_father_id"/>
        <result property="gbDfFoodImg" column="gb_df_food_img"/>
        <result property="gbDfFoodImgLarge" column="gb_df_food_img_large"/>
        <result property="gbDfFoodMethod" column="gb_df_food_method"/>
        <result property="gbDfFoodDetail" column="gb_df_food_detail"/>
        <result property="gbDfGoodsSort" column="gb_df_goods_sort"/>
        <result property="gbDfTargetGrossMarginRate" column="gb_df_target_gross_margin_rate"/>
        <result property="gbDfGrossMarginFloatAbs" column="gb_df_gross_margin_float_abs"/>
        <!-- 关联菜品的成分商品 -->
        <collection property="gbdisFoodGoodsEntities" resultMap="foodGoodsResult"/>
    </resultMap>

    <!-- 菜品成分的结果映射（包含关联商品详情） -->
    <resultMap id="foodGoodsResult" type="com.nongxinle.entity.GbDistributerFoodGoodsEntity">
        <id property="gbDistributerFoodGoodsId" column="gb_distributer_food_goods_id"/>
        <result property="gbDfgFoodId" column="gb_dfg_food_id"/>
        <result property="gbDfgDisGoodsId" column="gb_dfg_dis_goods_id"/>
        <result property="gbDfgStatus" column="gb_dfg_status"/>
        <result property="gbDfgGoodsAmount" column="gb_dfg_goods_amount"/>
        <result property="gbDfgGoodsName" column="gb_dfg_goods_name"/>
        <result property="gbDfgGoodsStandardname" column="gb_dfg_goods_standardname"/>
        <!-- 关联商品详情 -->
        <association property="gbDistributerGoodsEntity" javaType="com.nongxinle.entity.GbDistributerGoodsEntity">
            <id property="gbDistributerGoodsId" column="gb_distributer_goods_id"/>
            <result property="gbDgGoodsName" column="gb_dg_goods_name"/>
            <result property="gbDgGoodsStandardname" column="gb_dg_goods_standardname"/>
            <result property="gbDgGoodsDetail" column="gb_dg_goods_detail"/>
            <result property="gbDgGoodsBrand" column="gb_dg_goods_brand"/>
            <result property="gbDgGoodsPlace" column="gb_dg_goods_place"/>
            <result property="gbDgGoodsPrice" column="gb_dg_goods_price"/>
            <result property="gbDgGoodsLowestPrice" column="gb_dg_goods_lowest_price"/>
            <result property="gbDgGoodsHighestPrice" column="gb_dg_goods_highest_price"/>
            <result property="gbDgControlPrice" column="gb_dg_control_price"/>
            <result property="gbDgControlFresh" column="gb_dg_control_fresh"/>
            <result property="gbDgGoodsType" column="gb_dg_goods_type"/>
            <result property="gbDgDfgGoodsFatherId" column="gb_dg_dfg_goods_father_id"/>
            <result property="gbDgDfgGoodsGrandId" column="gb_dg_dfg_goods_grand_id"/>
            <result property="gbDgDfgGoodsGreatId" column="gb_dg_dfg_goods_great_id"/>
            <result property="gbDgNxGoodsId" column="gb_dg_nx_goods_id"/>
            <result property="gbDgNxFatherImg" column="gb_dg_nx_father_img"/>
            <result property="gbDgNxFatherImgLarge" column="gb_dg_nx_father_img_large"/>
            <result property="gbDgNxDistributerGoodsPrice" column="gb_dg_nx_distributer_goods_price"/>
            <result property="gbDgGbDepartmentId" column="gb_dg_gb_department_id"/>
            <result property="gbDgGoodsIsWeight" column="gb_dg_goods_is_weight"/>
            <result property="gbDgPullOff" column="gb_dg_pull_off"/>
            <result property="gbDgGoodsSonsSort" column="gb_dg_goods_sons_sort"/>
            <result property="gbDgSellingPrice" column="gb_dg_selling_price"/>
        </association>
    </resultMap>

    <select id="queryObject" resultType="com.nongxinle.entity.GbDistributerFoodEntity">
        select * from gb_distributer_food where gb_distributer_food_id = #{value}
    </select>

    <select id="queryList" resultType="com.nongxinle.entity.GbDistributerFoodEntity">
        select * from gb_distributer_food
        <if test="offset != null and limit != null">
            limit #{offset}, #{limit}
        </if>
    </select>

    <select id="queryTotal" resultType="int">
        select count(*) from gb_distributer_food
    </select>

    <select id="queryFoodByParams" resultMap="foodWithGoods">
        SELECT DISTINCT f.*,
               fg.gb_distributer_food_goods_id, fg.gb_dfg_food_id, fg.gb_dfg_dis_goods_id,
               fg.gb_dfg_status, fg.gb_dfg_goods_standardname, fg.gb_dfg_goods_amount,
               fg.gb_dfg_goods_name,
               dg.gb_distributer_goods_id, dg.gb_dg_goods_name, dg.gb_dg_goods_standardname,
               dg.gb_dg_goods_detail, dg.gb_dg_goods_brand, dg.gb_dg_goods_place,
               dg.gb_dg_goods_price, dg.gb_dg_goods_lowest_price, dg.gb_dg_goods_highest_price,
               dg.gb_dg_control_price, dg.gb_dg_control_fresh, dg.gb_dg_goods_type,
               dg.gb_dg_dfg_goods_father_id, dg.gb_dg_dfg_goods_grand_id, dg.gb_dg_dfg_goods_great_id,
               dg.gb_dg_nx_goods_id, dg.gb_dg_nx_father_img, dg.gb_dg_nx_father_img_large,
               dg.gb_dg_nx_distributer_goods_price,
               dg.gb_dg_gb_department_id, dg.gb_dg_goods_is_weight, dg.gb_dg_pull_off,
               dg.gb_dg_goods_sons_sort, dg.gb_dg_selling_price
        FROM gb_distributer_food f
        LEFT JOIN gb_distributer_food_goods fg ON fg.gb_dfg_food_id = f.gb_distributer_food_id
        LEFT JOIN gb_distributer_goods dg ON dg.gb_distributer_goods_id = fg.gb_dfg_dis_goods_id
        <where>
            <if test="fatherId != null">
                and f.gb_df_food_father_id = #{fatherId}
            </if>
            <if test="disId != null">
                and f.gb_df_distributer_id = #{disId}
            </if>
            <if test="foodName != null">
                and f.gb_df_food_name = #{foodName}
            </if>
            <if test="dayuFatherId != null">
                and f.gb_df_food_father_id &gt; #{dayuFatherId}
            </if>
        </where>
        ORDER BY f.gb_distributer_food_id
    </select>

    <select id="queryDisAllFood" resultType="com.nongxinle.entity.GbDistributerFoodEntity">
        select * from gb_distributer_food
        <where>
            <if test="disId != null">
                and gb_df_distributer_id = #{disId}
            </if>
            <if test="fatherId != null">
                and gb_df_food_father_id = #{fatherId}
            </if>
        </where>
    </select>

    <insert id="save" parameterType="com.nongxinle.entity.GbDistributerFoodEntity" useGeneratedKeys="true" keyProperty="gbDistributerFoodId">
        insert into gb_distributer_food
        (gb_df_distributer_id, gb_df_nx_food_id, gb_df_food_name, gb_df_food_price, gb_df_status,
         gb_df_food_pinyin, gb_df_food_py, gb_df_food_father_id, gb_df_food_img, gb_df_food_img_large,
         gb_df_food_method, gb_df_food_detail, gb_df_goods_sort, gb_df_target_gross_margin_rate, gb_df_gross_margin_float_abs)
        values
        (#{gbDfDistributerId}, #{gbDfNxFoodId}, #{gbDfFoodName}, #{gbDfFoodPrice}, #{gbDfStatus},
         #{gbDfFoodPinyin}, #{gbDfFoodPy}, #{gbDfFoodFatherId}, #{gbDfFoodImg}, #{gbDfFoodImgLarge},
         #{gbDfFoodMethod}, #{gbDfFoodDetail}, #{gbDfGoodsSort}, #{gbDfTargetGrossMarginRate}, #{gbDfGrossMarginFloatAbs})
    </insert>

    <update id="update" parameterType="com.nongxinle.entity.GbDistributerFoodEntity">
        update gb_distributer_food
        <set>
            <if test="gbDfFoodName != null">`gb_df_food_name` = #{gbDfFoodName},</if>
            <if test="gbDfFoodPrice != null">`gb_df_food_price` = #{gbDfFoodPrice},</if>
            <if test="gbDfFoodImg != null">`gb_df_food_img` = #{gbDfFoodImg},</if>
            <if test="gbDfFoodMethod != null">`gb_df_food_method` = #{gbDfFoodMethod},</if>
            <if test="gbDfFoodFatherId != null">`gb_df_food_father_id` = #{gbDfFoodFatherId},</if>
            <if test="gbDfDistributerId != null">`gb_df_distributer_id` = #{gbDfDistributerId},</if>
            <if test="gbDfStatus != null">`gb_df_status` = #{gbDfStatus},</if>
            <if test="gbDfFoodPinyin != null">`gb_df_food_pinyin` = #{gbDfFoodPinyin},</if>
            <if test="gbDfFoodPy != null">`gb_df_food_py` = #{gbDfFoodPy},</if>
            <if test="gbDfGoodsSort != null">`gb_df_goods_sort` = #{gbDfGoodsSort},</if>
            <if test="gbDfTargetGrossMarginRate != null">`gb_df_target_gross_margin_rate` = #{gbDfTargetGrossMarginRate},</if>
            <if test="gbDfGrossMarginFloatAbs != null">`gb_df_gross_margin_float_abs` = #{gbDfGrossMarginFloatAbs},</if>
        </set>
        where gb_distributer_food_id = #{gbDistributerFoodId}
    </update>

    <delete id="delete">
        delete from gb_distributer_food where gb_distributer_food_id = #{value}
    </delete>

    <delete id="deleteBatch">
        delete from gb_distributer_food where gb_distributer_food_id in
        <foreach item="gbDistributerFoodId" collection="array" open="(" separator="," close=")">
            #{gbDistributerFoodId}
        </foreach>
    </delete>

</mapper>

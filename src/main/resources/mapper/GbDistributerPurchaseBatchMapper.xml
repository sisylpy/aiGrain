                     column="gb_dpb_sell_user_id" 
                     select="querySellerById"/>
        
        <!-- 嵌套查询供货商 -->
        <association property="nxJrdhSupplierEntity" javaType="com.nongxinle.entity.NxJrdhSupplierEntity"
                     column="gb_dpb_supplier_id" 
                     select="querySupplierById"/>
        
        <!-- 嵌套查询采购商品 -->
        <collection property="gbDPGEntities" ofType="com.nongxinle.entity.GbDistributerPurchaseGoodsEntity"
                    column="gb_distributer_purchase_batch_id" 
                    select="queryPurchaseGoodsByBatchId"/>
    </resultMap>

    <resultMap id="goods" type="com.nongxinle.entity.GbDistributerGoodsEntity">

    <!-- 老项目迁移: queryObject SQL (包含父子级联) -->
    <select id="queryObject" resultMap="nxGoods">
        select g.nx_goods_id,
               g.nx_goods_name,
               g.nx_goods_detail,
               g.nx_goods_brand,
               g.nx_goods_place,
               g.nx_goods_standardname,
               g.nx_goods_standard_weight,
               g.nx_goods_file,
               g.nx_goods_file_big,
               g.nx_goods_standard_amount,
               g.nx_goods_father_id,
               g.nx_goods_pinyin,
               g.nx_goods_py,
               g.nx_goods_is_oldest_son,
               g.nx_goods_sons_sort,
               g.nx_goods_grand_id,
               g.nx_goods_level,
               g.nx_goods_sort,
               g.nx_goods_is_hidden,
               g.nx_goods_quantity_days,
               g.nx_goods_carton_unit,
               g.nx_goods_items_per_carton,

               f.nx_goods_id as f_nx_goods_id,
               f.nx_goods_name as f_nx_goods_name,
               f.nx_goods_file as f_nx_goods_file,
               f.nx_goods_file_big as f_nx_goods_file_big,
               f.nx_goods_father_id as f_nx_goods_father_id,
               f.nx_goods_grand_id as f_nx_goods_grand_id,
               f.nx_goods_sort as f_nx_goods_sort,
               f.nx_goods_sons_sort as f_nx_goods_sons_sort,
               f.nx_goods_is_hidden as f_nx_goods_is_hidden,
               f.nx_goods_quantity_days as f_nx_goods_quantity_days,

               grand.nx_goods_id as grand_nx_goods_id,
               grand.nx_goods_name as grand_nx_goods_name,
               grand.nx_goods_father_id as grand_nx_goods_father_id,
               grand.nx_goods_file as grand_nx_goods_file,
               grand.nx_goods_file_big as grand_nx_goods_file_big,
               grand.nx_goods_sort as grand_nx_goods_sort,
               grand.nx_goods_sons_sort as grand_nx_goods_sons_sort,
               grand.nx_goods_quantity_days as grand_nx_goods_quantity_days,

               greatgrand.nx_goods_id as greatgrand_nx_goods_id,
               greatgrand.nx_goods_name as greatgrand_nx_goods_name,
               greatgrand.nx_goods_sort as greatgrand_nx_goods_sort,
               greatgrand.nx_goods_sons_sort as greatgrand_nx_goods_sons_sort,
               greatgrand.nx_goods_file as greatgrand_nx_goods_file,
               greatgrand.nx_goods_file_big as greatgrand_nx_goods_file_big
        from nx_goods g
        left join nx_goods f on f.nx_goods_id = g.nx_goods_father_id
        left join nx_goods grand on grand.nx_goods_id = f.nx_goods_father_id
        left join nx_goods greatgrand on greatgrand.nx_goods_id = grand.nx_goods_father_id
        where g.nx_goods_id = #{nxGoodsId}
    </select>


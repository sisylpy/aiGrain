    <!-- 获取商品分类列表 -->
    <select id="getNxGoodsCateList" resultMap="nxGoodsCateList">
        select g.nx_goods_id         as nx_goods_id,
               g.nx_goods_name       as nx_goods_name,
               g.nx_goods_file       as nx_goods_file,
               g.nx_goods_sort       as nx_goods_sort,
               g.nx_goods_sons_sort  as nx_goods_sons_sort,
               gg.nx_goods_id        as sub_nx_goods_id,
               gg.nx_goods_name      as sub_nx_goods_name,
               gg.nx_goods_detail    as sub_nx_goods_detail,
               gg.nx_goods_file      as sub_nx_goods_file,
               gg.nx_goods_father_id as sub_nx_goods_father_id,
               gg.nx_goods_sort      as sub_nx_goods_sort
        from nx_goods as g
        left join nx_goods as gg on g.nx_goods_id = gg.nx_goods_father_id
        where g.nx_goods_father_id = 0
        order by g.nx_goods_sort, g.nx_goods_sons_sort, gg.nx_goods_sort, gg.nx_goods_sons_sort
    </select>

    <!-- 查询商品ID列表（排序与 queryGbDepNxGrandGoodsByGreatId 内层一致，便于与分页列表顺序对齐） -->
    <select id="queryOnlyGoodsIds" resultType="java.lang.Integer">
        select dg.nx_goods_id
        from nx_goods as dg
        left join nx_goods as f on f.nx_goods_id = dg.nx_goods_father_id
        left join nx_goods as g on g.nx_goods_id = f.nx_goods_father_id
        left join nx_goods as gg on gg.nx_goods_id = g.nx_goods_father_id
        <where>
            <if test="isHidden != null">
                AND dg.nx_goods_is_hidden = #{isHidden}
            </if>
            <!-- 与 queryGbDepNxGrandGoodsByGreatId 相同：按一级类目祖先 gg 限定，不用 dg.nx_goods_great_grand_id，避免与树路径不一致时顺序/集合错位 -->
            <if test="greatGrandId != null">
                AND gg.nx_goods_id = #{greatGrandId}
            </if>
            and dg.nx_goods_level = 3
        </where>
        ORDER BY
        gg.nx_goods_sort,
        g.nx_goods_sort,
        f.nx_goods_sort,
        dg.nx_goods_sort,
        dg.nx_goods_sons_sort
    </select>

    <!-- 根据一级分类(greatGrandId)查询商品数量（与 queryGbDepNxGrandGoodsByGreatId 内层同一套祖先限定） -->
    <!-- 原方法名: queryNxGoodsCountByFatherId（已废弃） -->
    <select id="queryNxGoodsCountByGreatGrandId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM nx_goods AS dg
        LEFT JOIN nx_goods AS f ON f.nx_goods_id = dg.nx_goods_father_id
        LEFT JOIN nx_goods AS g ON g.nx_goods_id = f.nx_goods_father_id
        LEFT JOIN nx_goods AS gg ON gg.nx_goods_id = g.nx_goods_father_id
        WHERE dg.nx_goods_level = 3
          AND dg.nx_goods_is_hidden = 0
          AND gg.nx_goods_id = #{greatGrandId}
    </select>

    <!-- 根据一级分类(greatGrandId)分页查询商品 -->
    <!-- 原方法名: queryNxGoodsPageByFatherId（已废弃） -->
    <select id="queryNxGoodsPageByGreatGrandId" resultMap="BaseResultMap">
        select *
        from nx_goods
        where nx_goods_great_grand_id = #{greatGrandId}
        and nx_goods_level = 3
        and nx_goods_is_hidden = 0
        order by nx_goods_sort, nx_goods_sons_sort
        limit #{limit} offset #{offset}
    </select>

    <!-- ========== 老项目迁移: queryGbDepNxGrandGoodsByGreatId ========== -->
    <!-- 根据一级分类(greatGrandId/grandId)查询商品，包含批发商商品、部门商品、订单、库存等完整信息 -->
    <select id="queryGbDepNxGrandGoodsByGreatId" parameterType="map" resultMap="goodsWithGbOrder">
        SELECT
            limited_goods.*,
            ns.nx_standard_id,
            ns.nx_s_goods_id,
            ns.nx_standard_name,
            ns.nx_standard_scale,
            ns.nx_standard_file_path,
            na.nx_alias_id,
            na.nx_alias_name,
            na.nx_als_goods_id,
            gdg.gb_distributer_goods_id,
            gdg.gb_dg_nx_goods_id,
            gdg.gb_dg_goods_name,
            gdg.gb_dg_goods_standardname,
            gdg.gb_dg_goods_detail,
            gdg.gb_dg_goods_place,
            gdg.gb_dg_goods_brand,
            gdg.gb_dg_goods_standard_weight,
            gdg.gb_dg_goods_price,
            gdg.gb_dg_goods_lowest_price,
            gdg.gb_dg_goods_highest_price,
            gdg.gb_dg_control_price,
            gdg.gb_dg_control_fresh,
            gdg.gb_dg_fresh_warn_hour,
            gdg.gb_dg_fresh_waste_hour,
            gdg.gb_dg_goods_inventory_type,
            gdg.gb_dg_goods_type,
            gdg.gb_dg_is_franchise_price,
            gdg.gb_dg_franchise_price_one,
            gdg.gb_dg_franchise_price_two,
            gdg.gb_dg_franchise_price_three,
            gdg.gb_dg_is_self_control,
            gdg.gb_dg_self_price,
            gdg.gb_dg_goods_sort,
            gdg.gb_dg_goods_sons_sort,
            gdg.gb_dg_nx_father_img,
            gdg.gb_dg_nx_father_img_large,
            gdg.gb_dg_gb_supplier_id,
            gdg.gb_dg_nx_distributer_id,
            gdg.gb_dg_nx_distributer_goods_id,
            gdg.gb_dg_distributer_id,
            gdg.gb_dg_selling_price,
            gdg.gb_dg_pull_off,
            gdg.gb_dg_dfg_goods_father_id,
            gdg.gb_dg_dfg_goods_grand_id,
            gdg.gb_dg_dfg_goods_great_id,
            gdg.gb_dg_goods_is_weight,
            gs.gb_distributer_standard_id AS gb_distributer_standard_id,
            gs.gb_DS_standard_name,
            gs.gb_DS_standard_scale,
            gs.gb_DS_dis_goods_id,
            ga.gb_distributer_alias_id,
            ga.gb_da_alias_name,
            ga.gb_da_dis_goods_id,
            gddg.gb_department_dis_goods_id,
            gddg.gb_DDG_order_goods_name,
            gddg.gb_DDG_order_price_level,
            gddg.gb_DDG_print_standard,
            gddg.gb_DDG_dep_goods_name,
            gddg.gb_DDG_dep_goods_standardname,
            gddg.gb_DDG_goods_type,
            gddg.gb_DDG_department_id,
            gddg.gb_DDG_nx_distributer_id,
            gddg.gb_DDG_nx_distributer_goods_id,
            gddg.gb_DDG_dis_goods_id,
            gddg.gb_DDG_dis_goods_father_id,
            gddg.gb_DDG_dis_goods_grand_id,
            gddg.gb_DDG_dis_goods_great_id,
            gddg.gb_DDG_gb_dis_id,
            gddg.gb_DDG_stock_total_subtotal,
            gddg.gb_DDG_stock_total_weight,
            gddg.gb_DDG_prepare_total_weight,
            gddg.gb_DDG_show_standard_id,
            gddg.gb_DDG_show_standard_name,
            gddg.gb_DDG_show_standard_scale,
            gddg.gb_DDG_selling_price,
            gddg.gb_DDG_order_date,
            gddg.gb_DDG_order_price,
            gddg.gb_DDG_order_quantity,
            gddg.gb_DDG_order_remark,
            gddg.gb_DDG_order_standard,
            gddg.gb_DDG_order_weight,
            gddg.gb_DDG_inventory_date,
            gddg.gb_DDG_inventory_full_time,
            gddg.gb_DDG_prepare_status,
            gddg.gb_DDG_department_father_id,
            gds.gb_department_goods_stock_id,
            gds.gb_dgs_gb_dis_goods_id,
            gds.gb_dgs_gb_dep_dis_goods_id,
            gds.gb_dgs_gb_department_id,
            gds.gb_dgs_rest_weight,
            gds.gb_dgs_rest_subtotal,
            gds.gb_dgs_weight,
            gds.gb_dgs_subtotal,
            gds.gb_dgs_price,
            gds.gb_dgs_date,
            gds.gb_dgs_status,
            gdo.gb_department_orders_id,
            gdo.gb_do_goods_name,
            gdo.gb_DO_nx_goods_id,
            gdo.gb_DO_dis_goods_id,
            gdo.gb_DO_dis_goods_father_id,
            gdo.gb_DO_dep_dis_goods_id,
            gdo.gb_DO_department_id,
            gdo.gb_DO_distributer_id,
            gdo.gb_DO_status,
            gdo.gb_DO_price,
            gdo.gb_DO_weight,
            gdo.gb_DO_subtotal,
            gdo.gb_DO_quantity,
            gdo.gb_DO_standard,
            gdo.gb_DO_remark,
            gdo.gb_DO_apply_date,
            gdo.gb_DO_apply_full_time,
            gdo.gb_DO_arrive_date,
            gdo.gb_DO_arrive_what_day,
            gdo.gb_DO_scale_weight,
            gdo.gb_DO_scale_price,
            gdo.gb_DO_buy_status,
            gdo.gb_DO_goods_type,
            gdo.gb_DO_order_type,
            gdo.gb_DO_selling_price,
            gdo.gb_DO_selling_subtotal
        FROM (
            SELECT
                ng.nx_goods_id AS nx_goods_id,
                ng.nx_goods_name AS nx_goods_name,
                ng.nx_goods_standardname AS nx_goods_standardname,
                ng.nx_goods_standard_weight AS nx_goods_standard_weight,
                ng.nx_goods_father_id AS nx_goods_father_id,
                ng.nx_goods_grand_id AS nx_goods_grand_id,
                ng.nx_goods_great_grand_id AS nx_goods_great_grand_id,
                ng.nx_goods_sort AS nx_goods_sort,
                ng.nx_goods_sons_sort AS nx_goods_sons_sort,
                ng.nx_goods_file AS nx_goods_file,
                ng.nx_goods_file_big AS nx_goods_file_big,
                ng.nx_goods_detail AS nx_goods_detail,
                ng.nx_goods_brand AS nx_goods_brand,
                ng.nx_goods_level AS nx_goods_level,
                ng.nx_goods_is_hidden AS nx_goods_is_hidden,
                ng.nx_goods_is_oldest_son AS nx_goods_is_oldest_son,
                ng.nx_goods_place AS nx_goods_place,
                ng.nx_goods_quantity_days AS nx_goods_quantity_days,
                ng.nx_goods_carton_unit AS nx_goods_carton_unit,
                ng.nx_goods_items_per_carton AS nx_goods_items_per_carton
            FROM nx_goods AS ng
            LEFT JOIN nx_goods AS f ON f.nx_goods_id = ng.nx_goods_father_id
            LEFT JOIN nx_goods AS g ON g.nx_goods_id = f.nx_goods_father_id
            LEFT JOIN nx_goods AS gg ON gg.nx_goods_id = g.nx_goods_father_id
            <where>
                <!-- 只查第3级商品（真正的商品，不是分类目录） -->
                ng.nx_goods_level = 3
                <if test="greatGrandId != null">
                    AND gg.nx_goods_id = #{greatGrandId}
                </if>
                <if test="grandId != null">
                    AND g.nx_goods_id = #{grandId}
                </if>
                <if test="fatherId != null">
                    AND ng.nx_goods_father_id = #{fatherId}
                </if>
                <if test="isHidden != null">
                    AND ng.nx_goods_is_hidden = #{isHidden}
                </if>
            </where>
            ORDER BY
                gg.nx_goods_sort,
                g.nx_goods_sort,
                f.nx_goods_sort,
                ng.nx_goods_sort,
                ng.nx_goods_sons_sort
            <if test="offset != null and limit != null">
                LIMIT #{offset}, #{limit}
            </if>
        ) AS limited_goods

        LEFT JOIN nx_standard AS ns ON ns.nx_s_goods_id = limited_goods.nx_goods_id
        LEFT JOIN nx_alias AS na ON na.nx_als_goods_id = limited_goods.nx_goods_id
        LEFT JOIN gb_distributer_goods AS gdg ON gdg.gb_dg_nx_goods_id = limited_goods.nx_goods_id
            AND gdg.gb_dg_distributer_id = #{gbDisId}
        LEFT JOIN gb_distributer_standard AS gs ON gs.gb_DS_dis_goods_id = gdg.gb_distributer_goods_id
        LEFT JOIN gb_distributer_alias AS ga ON ga.gb_da_dis_goods_id = gdg.gb_distributer_goods_id
        LEFT JOIN gb_department_dis_goods AS gddg ON gddg.gb_DDG_dis_goods_id = gdg.gb_distributer_goods_id
            AND gddg.gb_DDG_department_id = #{gbDepId}
        LEFT JOIN gb_department_goods_stock AS gds ON gds.gb_dgs_gb_dep_dis_goods_id = gddg.gb_department_dis_goods_id
        LEFT JOIN gb_department_orders AS gdo ON gdo.gb_DO_nx_goods_id = limited_goods.nx_goods_id
            AND gdo.gb_DO_status &lt; 3
            AND gdo.gb_DO_department_id = #{gbDepId}

        ORDER BY
            limited_goods.nx_goods_sort,
            limited_goods.nx_goods_sons_sort
    </select>

</mapper>
